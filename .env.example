# Local development configuration
# For deployment, these are set via Terraform / the deploy command.
#
# Nothing in app/ hardcodes a project id, project number or endpoint: every
# environment-specific value is resolved from the variables below, so the same
# artifact runs unmodified in dev, staging, prod and CI.

# ---------------------------------------------------------------------------
# Vertex AI / model configuration
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# gemini-3.6-flash is served from the global endpoint; regional endpoints 404.
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# cymbal_analytics_tool - published BigQuery Data Agent
# Provide DATA_AGENT_NAME, or DATA_AGENT_ID and let it be composed from
# GOOGLE_CLOUD_PROJECT + DATA_AGENT_LOCATION.
# ---------------------------------------------------------------------------
DATA_AGENT_NAME=projects/your-gcp-project-id/locations/global/dataAgents/your-data-agent-id
# DATA_AGENT_ID=your-data-agent-id
# DATA_AGENT_LOCATION=global

# ---------------------------------------------------------------------------
# pos_troubleshooting_rag_tool - BigQuery vector search
# ---------------------------------------------------------------------------
BIGQUERY_LOCATION=us-central1
POS_CHUNK_DATASET=cymbal_gold
POS_CHUNK_TABLE=pos_manual_chunk_embeddings
# Certified-match threshold; must stay in sync with
# tests/eval/contracts/pos_rag_contract.yaml
POS_RAG_MIN_SIMILARITY=0.70

# ---------------------------------------------------------------------------
# bigtable_mcp_toolset - Cloud Run Database Toolbox microservice
# Provide BIGTABLE_MCP_SERVICE_URL, or provide GOOGLE_CLOUD_PROJECT_NUMBER and
# let the endpoint be composed from the service name and region.
# ---------------------------------------------------------------------------
BIGTABLE_MCP_SERVICE_URL=https://your-mcp-service-<project-number>.us-central1.run.app
# GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
# BIGTABLE_MCP_SERVICE_NAME=mcp-toolbox-bigtable
# BIGTABLE_MCP_REGION=us-central1

# ---------------------------------------------------------------------------
# Database Toolbox server (tools.yaml) - set these on the Cloud Run service
# that hosts the MCP Toolbox, not on the agent. tools.yaml interpolates them at
# start-up so the same file deploys unchanged to dev / staging / prod.
# ---------------------------------------------------------------------------
BIGTABLE_PROJECT_ID=your-gcp-project-id
BIGTABLE_INSTANCE_ID=operations-db


# ---------------------------------------------------------------------------
# BigQuery Agent Analytics telemetry (app/telemetry.py)
# Streams prompts, LLM responses, tool arguments, latency, token usage and
# errors to BigQuery over the Storage Write API. The `events` table and its
# `v_*` views are created automatically on first write.
# Telemetry fails open: if these are unset, or the bigquery-analytics extra is
# missing, the agent still starts with telemetry disabled.
# ---------------------------------------------------------------------------
PROJECT_ID=your-gcp-project-id
BQ_TELEMETRY_DATASET=agent_telemetry
# Must match the dataset's actual BigQuery location.
REGION=us-central1
# BQ_TELEMETRY_TABLE=events
# Set to false to disable telemetry entirely (e.g. offline development).
# BQ_TELEMETRY_ENABLED=false

# ---------------------------------------------------------------------------
# Testing
# Live end-to-end tests boot a uvicorn server and call cloud backends; they are
# skipped unless this is set, so `pytest` is hermetic by default.
# ---------------------------------------------------------------------------
# RUN_E2E_TESTS=1
